# AWS Credentials
# Required for accessing AWS services (S3, Secrets Manager, Bedrock)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_DEFAULT_REGION=us-east-1

# Stack Configuration
# Name of the CDK stack - used as prefix for AWS resources
STACK_NAME=StudentFeedback

# Security Configuration
# Custom header value to prevent ALB from accepting requests from sources other than CloudFront
# Generate a random string for production use
CUSTOM_HEADER_VALUE=My_random_value_58dsvasdaswcd5e4s31

# Custom header name for ALB security
CUSTOM_HEADER_NAME=X-Custom-Header

# Secrets Manager Configuration
# ID of the Secrets Manager secret containing Cognito parameters
# Format: {STACK_NAME}ParamCognitoSecret{suffix}
SECRETS_MANAGER_ID=StudentFeedbackParamCognitoSecret12345

# Region Configuration
# AWS region for CDK stack deployment
DEPLOYMENT_REGION=us-east-1

# AWS region for Bedrock service (if different from deployment region)
BEDROCK_REGION=us-east-1

# S3 Configuration
# S3 bucket name for storing application data (feedback, poll responses, etc.)
# Note: Different apps may use different buckets:
#   - app.py uses: awsbin-arkansasonline-poll
#   - studentfeedback_app.py uses: awsbin-amazonq-assets
S3_BUCKET_NAME=awsbin-arkansasonline-poll
